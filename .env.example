# GitHub Token：用于提高 API 配额、访问私有种子仓库。
# 留空也能跑，但额度低、易被限流。复制本文件为 .env 后填入。
GITHUB_TOKEN=

# 可选：覆盖监听地址 / 端口 / 数据库路径（一般不用改）
# LXH_HOST=0.0.0.0
# LXH_PORT=8787
# LXH_DB=/app/data/lxhub.db

# 网页后台账号密码：设置 LXH_ADMIN_PASS 后才启用后台鉴权，
# 未设置时 /api/crawl、/api/check 等保持公开（极简部署）。
# LXH_ADMIN_USER=admin
# LXH_ADMIN_PASS=
